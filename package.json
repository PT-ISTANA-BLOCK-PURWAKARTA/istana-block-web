{
  "name": "istana-block-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=./seed/seed.sql",
    "demo:generate": "node scripts/demo/generate.mjs",
    "demo:local": "wrangler d1 execute DB --local --file=./seed/demo-erp.sql",
    "demo:remote": "wrangler d1 execute DB --remote --file=./seed/demo-erp.sql",
    "demo:hapus:local": "wrangler d1 execute DB --local --file=./seed/demo-erp-hapus.sql",
    "demo:hapus:remote": "wrangler d1 execute DB --remote --file=./seed/demo-erp-hapus.sql",
    "demo:worker:migrate": "wrangler d1 migrations apply DB --remote --config wrangler.demo.jsonc",
    "demo:worker:seed": "wrangler d1 execute DB --remote --config wrangler.demo.jsonc --file=./seed/seed.sql",
    "demo:worker:data": "wrangler d1 execute DB --remote --config wrangler.demo.jsonc --file=./seed/demo-erp.sql",
    "demo:worker:hapus": "wrangler d1 execute DB --remote --config wrangler.demo.jsonc --file=./seed/demo-erp-hapus.sql",
    "demo:worker:bersih": "wrangler d1 execute DB --remote --config wrangler.demo.jsonc --file=./seed/erp-mulai-bersih.sql",
    "demo:worker:akun": "node scripts/demo/akun-demo.mjs --remote --config wrangler.demo.jsonc",
    "demo:worker:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -c wrangler.demo.jsonc",
    "demo:gps": "node scripts/demo/simulasi-gps.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@opennextjs/cloudflare": "1.20.8",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.1.0",
    "leaflet": "^1.9.4",
    "next": "15.5.27",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.148.0"
  }
}
