{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "istana-block-web",
	// Akun Cloudflare ISTANA BLOCK (Istanablock@gmail.com). Tanpa ini wrangler memakai akun
	// pribadi (Abdussalimsan) yang tidak memiliki D1 proyek ini.
	"account_id": "a5dec0cac9600d717295b2b7699a3857",
	// worker.ts membungkus .open-next/worker.js dengan cache halaman publik (lihat komentar di sana).
	"main": "worker.ts",
	// Minify bundel: tanpa ini modul Operasional membuat Worker ±3,5 MB gzip, di atas batas 3 MB Workers Free.
	"minify": true,
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Cron tiap 5 menit: pengingat kalender, pengingat backup, laporan pimpinan, pengingat ISO.
	// Ditangani scheduled() di worker.ts -> src/lib/ops/cron.ts. Worker demo (wrangler.demo.jsonc) tanpa cron.
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	// ID deploy: bagian dari kunci cache di worker.ts, jadi deploy baru tidak menyajikan HTML lama.
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"vars": {
		// Ganti dengan domain produksi, dipakai untuk canonical, sitemap, dan Open Graph.
		"SITE_URL": "https://istanablockpurwakarta.com",
		// Container Google Tag Manager (Google Ads AW-858211595 + GA4). Hanya dimuat di host SITE_URL
		// atau saat uji Tag Assistant (?gtm_debug); lihat docs/pelacakan-google-ads.md.
		"GTM_ID": "GTM-PXSMDXD8"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "istana-block-web-db",
			// D1 di akun Istana Block, dibuat 28 Okt 2026; migrasi 0000-0006 sudah terpasang.
			"database_id": "2bd61157-3c54-4dfb-b06a-013499c67708",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "istana-block-media"
		}
	]
}
